# Salin menjadi backend/.env lalu isi nilainya.
PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=musikku_app
DB_PASSWORD=ganti_dengan_password_panjang_dan_acak
DB_NAME=db_alatmusik

# Wajib minimal 32 karakter acak. Contoh cara membuat:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
JWT_EXPIRES_IN=2h

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Set 1 hanya jika backend berada di belakang reverse proxy tepercaya.
TRUST_PROXY=0
UPLOAD_MAX_BYTES=5242880

# Hanya untuk script pembuatan akun admin/petugas.
# Jangan disimpan permanen setelah akun dibuat.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_RESET_PASSWORD=false

PETUGAS_EMAIL=
PETUGAS_USERNAME=
PETUGAS_PASSWORD=
PETUGAS_NAME=Petugas MusikKu
PETUGAS_RESET_PASSWORD=false
